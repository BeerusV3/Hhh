-- Giả lập loading
task.spawn(function()
    for i = 1, 10 do
        ProgressFill.Size = UDim2.new(i/10, 0, 1, 0)
        task.wait(0.1)
    end
    task.wait(0.2)
    TweenService:Create(Loader, TweenInfo.new(0.5), {BackgroundTransparency = 1}):Play()
    TweenService:Create(LoaderText, TweenInfo.new(0.5), {TextTransparency = 1}):Play()
    TweenService:Create(ProgressBar, TweenInfo.new(0.5), {BackgroundTransparency = 1}):Play()
    TweenService:Create(ProgressFill, TweenInfo.new(0.5), {BackgroundTransparency = 1}):Play()
    task.wait(0.5)
    Loader:Destroy()
    Notify("Hệ thống", "Đã tải thành công!", "success")
end)

