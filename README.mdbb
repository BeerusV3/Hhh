    Size = UDim2.new(1, 0, 0, 50), Position = UDim2.new(0, 0, 0.4, 0),
    BackgroundTransparency = 1, Text = "Đang tải Premium BF...", TextColor3 = Config.Theme.Accent,
    Font = Enum.Font.GothamBold, TextSize = 24, Parent = Loader
})
