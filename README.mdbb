-- ==========================================
-- 1. SERVICES & ENVIRONMENT SETUP
-- ==========================================
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")
local CoreGui = game:GetService("CoreGui")

local LocalPlayer = Players.LocalPlayer

-- Xóa UI cũ nếu chạy lại
pcall(function()
    local oldUI = CoreGui:FindFirstChild("PremiumBF_UI")
    if oldUI then oldUI:Destroy() end
    for _, v in pairs(Workspace:GetDescendants()) do
        if v.Name:find("^PBF_") then v:Destroy() end
    end
end)

-- ==========================================
-- 2. CONFIGURATION & THEME
-- ==========================================
local Config = {
    Theme = {
        Background = Color3.fromRGB(15, 15, 20),
        Secondary = Color3.fromRGB(25, 25, 35),
        Accent = Color3.fromRGB(170, 0, 255), -- Tím Neon
        Text = Color3.fromRGB(255, 255, 255),
        TextDim = Color3.fromRGB(150, 150, 160),
        Success = Color3.fromRGB(0, 255, 100),
        Danger = Color3.fromRGB(255, 50, 50)
    },
    State = {
        ESP_Players = false,
        ESP_Fruits = false,
        Hitbox = false,
        HitboxSize = 5,
        AutoHaki = false -- Demo
    }
}

-- ==========================================
-- 3. UTILITY FUNCTIONS
-- ==========================================
local function Create(className, properties, parent)
    local inst = Instance.new(className)
    for k, v in pairs(properties) do
        inst[k] = v
    end
    if parent then inst.Parent = parent end
    return inst
end

local function Notify(title, text, type)
    -- Hàm thông báo góc màn hình
    local SG = CoreGui:FindFirstChild("PBF_Notif")
    if not SG then
        SG = Create("ScreenGui", {Name="PBF_Notif", ResetOnSpawn=false, Parent=CoreGui})
    end
    local bgColor = Config.Theme.Secondary
    if type == "success" then bgColor = Config.Theme.Success elseif type == "error" then bgColor = Config.Theme.Danger end

    local frame = Create("Frame", {
        Size = UDim2.new(0, 250, 0, 50),
        Position = UDim2.new(1, -270, 0, 20),
        BackgroundColor3 = bgColor,
        BorderSizePixel = 0,
        Parent = SG
    })
    Create("UICorner", {CornerRadius = UDim.new(0, 6)}, frame)
    Create("TextLabel", {
        Size = UDim2.new(1, -20, 1, 0), Position = UDim2.new(0, 10, 0, 0),
        BackgroundTransparency = 1, Text = title .. ": " .. text,
        TextColor3 = Color3.new(1,1,1), Font = Enum.Font.GothamBold, TextSize = 12,
        TextXAlignment = Enum.TextXAlignment.Left, Parent = frame
    })
    task.delay(3, function()
        TweenService:Create(frame, TweenInfo.new(0.5), {Position = UDim2.new(1, 300, 0, 20)}):Play()
        task.wait(0.5)
        frame:Destroy()
    end)
end

