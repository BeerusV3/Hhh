-- TAB COMBAT
local CombatTab = TabContents["Combat"]
local hitboxOS = {}
CreateToggle(CombatTab, "Hitbox Mở Rộng (Đánh dễ trúng)", false, function(state)
    Config.State.Hitbox = state
    if not state then
        for p, s in pairs(hitboxOS) do if p and p.Parent then p.Size = s end end
        hitboxOS = {}
    end
end)
CreateSlider(CombatTab, "Kích thước Hitbox", 1, 20, 5, function(val)
    Config.State.HitboxSize = val
end)

-- Vòng lặp Hitbox (Tối ưu, chạy 0.2s/lần thay vì mỗi frame)
task.spawn(function()
    while task.wait(0.2) do
        if Config.State.Hitbox and LocalPlayer.Character then
            for _, v in pairs(Workspace:GetDescendants()) do
                if v:IsA("Model") and v:FindFirstChild("Humanoid") and v:FindFirstChild("Humanoid").Health > 0 and v ~= LocalPlayer.Character then
                    local root = v:FindFirstChild("HumanoidRootPart") or v:FindFirstChild("Head")
                    if root and not hitboxOS[root] then
                        hitboxOS[root] = root.Size
                        root.Size = Vector3.new(Config.State.HitboxSize, Config.State.HitboxSize, Config.State.HitboxSize)
                        root.Transparency = 1
                    end
                end
            end
        end
    end
end)

-- TAB ESP
local ESPTab = TabContents["ESP"]
local ESPObjects = {}

CreateToggle(ESPTab, "Bật ESP Người Chơi", false, function(state)
    Config.State.ESP_Players = state
    if not state then
        for obj, data in pairs(ESPObjects) do
            if data.Highlight then data.Highlight:Destroy() end
            if data.Billboard then data.Billboard:Destroy() end
        end
        ESPObjects = {}
    end
end)

-- Vòng lặp ESP (Chạy 1s/lần)
task.spawn(function()
    while task.wait(1) do
        if Config.State.ESP_Players then
            -- Dọn dẹp ESP của người đã chết/out
            for obj, data in pairs(ESPObjects) do
                if not obj.Parent or not obj:FindFirstChild("Humanoid") or obj.Humanoid.Health <= 0 then
                    if data.Highlight then data.Highlight:Destroy() end
                    if data.Billboard then data.Billboard:Destroy() end
                    ESPObjects[obj] = nil
                end
            end
            -- Thêm ESP mới
            for _, p in pairs(Players:GetPlayers()) do
                if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                    if not ESPObjects[p.Character] then
                        local hl = Instance.new("Highlight")
                        hl.Parent = p.Character
                        hl.FillColor = Color3.fromRGB(255, 0, 0)
                        hl.OutlineColor = Color3.fromRGB(255, 0, 0)
                        
                        local bb = Instance.new("BillboardGui")
                        bb.Parent = p.Character.Head
                        bb.Size = UDim2.new(0, 100, 0, 50)
                        bb.StudsOffset = Vector3.new(0, 2, 0)
                        bb.AlwaysOnTop = true
                        
                        local txt = Instance.new("TextLabel")
                        txt.Parent = bb
                        txt.Size = UDim2.new(1, 0, 1, 0)
                        txt.BackgroundTransparency = 1
                        txt.Text = p.Name
                        txt.TextColor3 = Color3.fromRGB(255,255,255)
                        txt.TextStrokeTransparency = 0
                        
                        ESPObjects[p.Character] = {Highlight = hl, Billboard = bb}
                    end
                end
            end
        end
    end
end)

-- TAB TELEPORT (Demo)
local TPTab = TabContents["Teleport"]
local Islands = {"Starter Island", "Marine Fortress", "Jungle", "Pirate Village", "Desert", "Frozen Village"}

for _, island in ipairs(Islands) do
    CreateButton(TPTab, "Dịch chuyển: " .. island, function()
        -- ĐÂY LÀ DEMO TELEPORT TRONG STUDIO HOẶC GAME CỦA BẠN
        -- Trong Blox Fruits thật, script này sẽ bị server kick do khoảng cách xa
        local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        if hrp then
            -- Lấy vị trí ngẫu nhiên gần đảo (giả lập)
            hrp.CFrame = hrp.CFrame + Vector3.new(0, 10, 0) 
            Notify("Teleport", "Đã dịch chuyển (Demo an toàn)", "success")
        end
    end)
end

-- TAB SETTINGS
local SettingsTab = TabContents["Settings"]
CreateButton(SettingsTab, "Ẩn/Hiện Nút Tròn", function()
    FAB.Visible = not FAB.Visible
end)
CreateButton(SettingsTab, "Tắt Toàn Bộ Chức Năng (Panic)", function()
    for k, _ in pairs(Config.State) do
        if type(Config.State[k]) == "boolean" then Config.State[k] = false end
    end
    for obj, data in pairs(ESPObjects) do
        if data.Highlight then data.Highlight:Destroy() end
        if data.Billboard then data.Billboard:Destroy() end
    end
    ESPObjects = {}
    for p, s in pairs(hitboxOS) do if p and p.Parent then p.Size = s end end
    hitboxOS = {}
    Notify("Hệ thống", "Đã tắt toàn bộ chức năng!", "error")
end)

