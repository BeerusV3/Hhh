end)

-- Tabs Implementation
local TabBar = Create("Frame", {
    Size = UDim2.new(0, 120, 1, -40), Position = UDim2.new(0, 0, 0, 40),
    BackgroundColor3 = Config.Theme.Secondary, BorderSizePixel = 0, Parent = MainFrame
})

local ContentArea = Create("Frame", {
    Size = UDim2.new(1, -120, 1, -40), Position = UDim2.new(0, 120, 0, 40),
    BackgroundColor3 = Config.Theme.Background, BorderSizePixel = 0, Parent = MainFrame
})

local Tabs = {
    {Name = "Main", Icon = "🏠"},
    {Name = "Combat", Icon = "⚔️"},
    {Name = "ESP", Icon = "👁️"},
    {Name = "Teleport", Icon = "🌍"},
    {Name = "Settings", Icon = "⚙️"}
}

local TabContents = {}

for i, tab in ipairs(Tabs) do
    local btn = Create("TextButton", {
        Size = UDim2.new(1, 0, 0, 40), Position = UDim2.new(0, 0, 0, (i-1)*40),
        BackgroundTransparency = 1, Text = "  " .. tab.Icon .. "  " .. tab.Name,
        TextColor3 = Config.Theme.TextDim, Font = Enum.Font.GothamBold, TextSize = 12,
        TextXAlignment = Enum.TextXAlignment.Left, Parent = TabBar
    })
    
    local content = Create("ScrollingFrame", {
        Size = UDim2.new(1, -20, 1, -20), Position = UDim2.new(0, 10, 0, 10),
        BackgroundTransparency = 1, BorderSizePixel = 0, CanvasSize = UDim2.new(0,0,0,0),
        AutomaticCanvasSize = Enum.AutomaticSize.Y, ScrollBarThickness = 2, Visible = (i==1), Parent = ContentArea
    })
    local layout = Create("UIListLayout", {Padding = UDim.new(0, 8)}, content)
    TabContents[tab.Name] = content
    
    btn.MouseButton1Click:Connect(function()
        for name, c in pairs(TabContents) do c.Visible = (name == tab.Name) end
        for _, b in ipairs(TabBar:GetChildren()) do
            if b:IsA("TextButton") then b.TextColor3 = Config.Theme.TextDim end
        end
        btn.TextColor3 = Config.Theme.Accent
    end)
end
TabBar:GetChildren()[1].TextColor3 = Config.Theme.Accent

-- UI Components Generators
local function CreateToggle(parent, text, default, callback)
    local frame = Create("Frame", {Size = UDim2.new(1, 0, 0, 35), BackgroundColor3 = Config.Theme.Secondary, Parent = parent})
    Create("UICorner", {CornerRadius = UDim.new(0, 6)}, frame)
    Create("TextLabel", {
        Size = UDim2.new(1, -60, 1, 0), Position = UDim2.new(0, 10, 0, 0),
        BackgroundTransparency = 1, Text = text, TextColor3 = Config.Theme.Text,
        Font = Enum.Font.Gotham, TextSize = 12, TextXAlignment = Enum.TextXAlignment.Left, Parent = frame
    })
    
    local btn = Create("TextButton", {
        Size = UDim2.new(0, 45, 0, 22), Position = UDim2.new(1, -55, 0.5, -11),
        BackgroundColor3 = default and Config.Theme.Accent or Color3.fromRGB(60, 60, 70),
        Text = default and "ON" or "OFF", TextColor3 = Color3.new(1,1,1), Font = Enum.Font.GothamBold, TextSize = 10, Parent = frame
    })
    Create("UICorner", {CornerRadius = UDim.new(0, 4)}, btn)
    
    local state = default
    btn.MouseButton1Click:Connect(function()
        state = not state
        btn.Text = state and "ON" or "OFF"
        btn.BackgroundColor3 = state and Config.Theme.Accent or Color3.fromRGB(60, 60, 70)
        pcall(callback, state) -- Bọc pcall chống crash
    end)
end

local function CreateSlider(parent, text, min, max, default, callback)
    local frame = Create("Frame", {Size = UDim2.new(1, 0, 0, 50), BackgroundColor3 = Config.Theme.Secondary, Parent = parent})
    Create("UICorner", {CornerRadius = UDim.new(0, 6)}, frame)
    local label = Create("TextLabel", {
        Size = UDim2.new(1, -20, 0, 20), Position = UDim2.new(0, 10, 0, 5),
        BackgroundTransparency = 1, Text = text .. ": " .. default, TextColor3 = Config.Theme.Text,
        Font = Enum.Font.Gotham, TextSize = 12, TextXAlignment = Enum.TextXAlignment.Left, Parent = frame
    })
    
    local bar = Create("Frame", {
        Size = UDim2.new(1, -20, 0, 6), Position = UDim2.new(0, 10, 0, 30),
        BackgroundColor3 = Color3.fromRGB(60,60,70), Parent = frame
    })
    Create("UICorner", {CornerRadius = UDim.new(1,0)}, bar)
    
    local fill = Create("Frame", {
        Size = UDim2.new((default-min)/(max-min), 0, 1, 0),
        BackgroundColor3 = Config.Theme.Accent, Parent = bar
    })
    Create("UICorner", {CornerRadius = UDim.new(1,0)}, fill)
    
    local isDragging = false
    bar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            isDragging = true
            local x = math.clamp((input.Position.X - bar.AbsolutePosition.X) / bar.AbsoluteSize.X, 0, 1)
            local val = math.floor(min + ((max - min) * x))
            fill.Size = UDim2.new(x, 0, 1, 0)
            label.Text = text .. ": " .. val
            pcall(callback, val)
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if isDragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local x = math.clamp((input.Position.X - bar.AbsolutePosition.X) / bar.AbsoluteSize.X, 0, 1)
            local val = math.floor(min + ((max - min) * x))
            fill.Size = UDim2.new(x, 0, 1, 0)
            label.Text = text .. ": " .. val
            pcall(callback, val)
        end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            isDragging = false
        end
    end)
end

local function CreateButton(parent, text, callback)
    local btn = Create("TextButton", {
        Size = UDim2.new(1, 0, 0, 35), BackgroundColor3 = Config.Theme.Secondary,
        Text = text, TextColor3 = Config.Theme.Text, Font = Enum.Font.GothamBold, TextSize = 12, Parent = parent
    })
    Create("UICorner", {CornerRadius = UDim.new(0, 6)}, btn)
    btn.MouseButton1Click:Connect(function()
        Notify("Hệ thống", "Đang thực thi...", "success")
        pcall(callback)
    end)
end

