local oldKick
oldKick = hookfunction(lp.Kick, function(self, msg)
    if AntiBan_State then
        StarterGui:SetCore("SendNotification", {Title = "Anti-Ban", Text = "Đã chặn lệnh Kick: " .. tostring(msg), Duration = 5})
        return
    else
        return oldKick(self, msg)
    end
end)

