-- TAB HOME
local HomeTab = TabContents["HOME"]
local WelcomeLbl = Create("TextLabel", {Size = UDim2.new(1,0,0,40), BackgroundTransparency = 1, Text = "Chào mừng, "..LocalPlayer.Name, TextColor3 = Config.Theme.Cyan, Font = Enum.Font.GothamBold, TextSize = 18, TextXAlignment = Enum.TextXAlignment.Left, Parent = HomeTab})
local StatusLbl = Create("TextLabel", {Size = UDim2.new(1,0,0,30), BackgroundTransparency = 1, Text = "Trạng thái: Đang chờ lệnh...", TextColor3 = Config.Theme.TextDim, Font = Enum.Font.Gotham, TextSize = 12, TextXAlignment = Enum.TextXAlignment.Left, Parent = HomeTab})

-- TAB AUTO FARM
local FarmTab = TabContents["AUTO FARM"]
local farmOS = {}

CreateToggle(FarmTab, "Bật Auto Farm (Kill Aura)", false, function(state)
    Config.State.AutoFarm = state
    if state then
        StatusLbl.Text = "Trạng thái: Auto Farm đang hoạt động"
        StatusLbl.TextColor3 = Config.Theme.Success
    else
        StatusLbl.Text = "Trạng thái: Đã dừng Auto Farm"
        StatusLbl.TextColor3 = Config.Theme.Danger
    end
end)
CreateSlider(FarmTab, "Bán kính Farm", 10, 150, 50, function(val) Config.State.FarmRadius = val end)

-- Vòng lặp Auto Farm (Tối ưu 0.2s/lần)
task.spawn(function()
    while task.wait(0.2) do
        if Config.State.AutoFarm and LocalPlayer.Character then
            local hrp = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
            local tool = LocalPlayer.Character:FindFirstChildOfClass("Tool")
            
            if hrp and tool then
                local nearestMob, minDist = nil, Config.State.FarmRadius or 50
                for _, v in pairs(Workspace:GetDescendants()) do
                    if v:IsA("Model") and v:FindFirstChild("Humanoid") and v.Humanoid.Health > 0 and v ~= LocalPlayer.Character then
                        local mHrp = v:FindFirstChild("HumanoidRootPart")
                        if mHrp then
                            local dist = (mHrp.Position - hrp.Position).Magnitude
                            if dist < minDist then minDist = dist; nearestMob = v end
                        end
                    end
                end
                
                if nearestMob then
                    pcall(function() tool:Activate() end) -- Tự động vung vũ khí
                end
            end
        end
    end
end)

-- TAB COMBAT
local CombatTab = TabContents["COMBAT"]
local hitboxOS = {}
CreateToggle(CombatTab, "Hitbox Expander (Đánh trúng)", false, function(state)
    Config.State.Hitbox = state
    if not state then
        for p, s in pairs(hitboxOS) do if p and p.Parent then p.Size = s end end
        hitboxOS = {}
    end
end)
CreateSlider(CombatTab, "Kích thước Hitbox", 2, 15, 5, function(val) Config.State.HitboxSize = val end)

task.spawn(function()
    while task.wait(0.3) do
        if Config.State.Hitbox and LocalPlayer.Character then
            for _, v in pairs(Workspace:GetDescendants()) do
                if v:IsA("Model") and v:FindFirstChild("Humanoid") and v.Humanoid.Health > 0 and v ~= LocalPlayer.Character then
                    local root = v:FindFirstChild("HumanoidRootPart")
                    if root and not hitboxOS[root] then
                        hitboxOS[root] = root.Size
                        root.Size = Vector3.new(Config.State.HitboxSize, Config.State.HitboxSize, Config.State.HitboxSize)
                        root.Transparency = 1
                    end
                end
            end
        end
    end
end)

-- TAB ESP
local ESPTab = TabContents["ESP"]
local ESPObjects = {}

local function ToggleESP(type, state)
    if not state then
        for obj, data in pairs(ESPObjects) do
            if data.Type == type then
                if data.Highlight then data.Highlight:Destroy() end
                ESPObjects[obj] = nil
            end
        end
    end
end

CreateToggle(ESPTab, "ESP Người Chơi (Đỏ)", false, function(s) Config.State.ESP_Players = s; ToggleESP("Player", s) end)
CreateToggle(ESPTab, "ESP Quái (Xanh Lá)", false, function(s) Config.State.ESP_Mobs = s; ToggleESP("Mob", s) end)
CreateToggle(ESPTab, "ESP Trái Cây (Vàng)", false, function(s) Config.State.ESP_Fruits = s; ToggleESP("Fruit", s) end)

-- Vòng lặp ESP thông minh
task.spawn(function()
    while task.wait(1) do
        if Config.State.ESP_Players then
            for _, p in pairs(Players:GetPlayers()) do
                if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                    if not ESPObjects[p.Character] then
                        local hl = Instance.new("Highlight", p.Character)
                        hl.FillColor = Color3.fromRGB(255, 0, 0)
                        hl.OutlineColor = Color3.fromRGB(255, 0, 0)
                        ESPObjects[p.Character] = {Highlight = hl, Type = "Player"}
                    end
                end
            end
        end
        
        if Config.State.ESP_Mobs then
            for _, v in pairs(Workspace:GetDescendants()) do
                if v:IsA("Model") and v:FindFirstChild("Humanoid") and v.Humanoid.Health > 0 and v ~= LocalPlayer.Character then
                    if not ESPObjects[v] then
                        local hl = Instance.new("Highlight", v)
                        hl.FillColor = Color3.fromRGB(0, 255, 0)
                        hl.OutlineColor = Color3.fromRGB(0, 255, 0)
                        ESPObjects[v] = {Highlight = hl, Type = "Mob"}
                    end
                end
            end
        end
        
        if Config.State.ESP_Fruits then
            for _, v in pairs(Workspace:GetDescendants()) do
                if v:IsA("Model") and (v.Name:lower():find("fruit") or v.Name:lower():find("apple") or v.Name:lower():find("dragon")) then
                    if not ESPObjects[v] then
                        local hl = Instance.new("Highlight", v)
                        hl.FillColor = Color3.fromRGB(255, 255, 0)
                        hl.OutlineColor = Color3.fromRGB(255, 255, 0)
                        ESPObjects[v] = {Highlight = hl, Type = "Fruit"}
                    end
                end
            end
        end
    end
end)

