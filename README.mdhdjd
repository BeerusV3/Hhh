-- ==========================================
-- 1. SERVICES & CLEANUP
-- ==========================================
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")
local CoreGui = game:GetService("CoreGui")

local LocalPlayer = Players.LocalPlayer

-- Dọn dẹp rác từ lần chạy trước
pcall(function()
    if CoreGui:FindFirstChild("PBF_Premium_UI") then CoreGui.PBF_Premium_UI:Destroy() end
    for _, v in pairs(Workspace:GetDescendants()) do
        if v.Name:find("^PBF_") then v:Destroy() end
    end
end)

-- ==========================================
-- 2. CONFIG & THEME
-- ==========================================
local Config = {
    Theme = {
        Bg = Color3.fromRGB(10, 10, 15),
        Panel = Color3.fromRGB(20, 20, 28),
        Accent = Color3.fromRGB(170, 0, 255), -- Tím Neon
        Cyan = Color3.fromRGB(0, 255, 255),
        Text = Color3.fromRGB(240, 240, 240),
        TextDim = Color3.fromRGB(150, 150, 160),
        Danger = Color3.fromRGB(255, 50, 50),
        Success = Color3.fromRGB(0, 255, 100)
    },
    State = {
        AutoFarm = false,
        Hitbox = false,
        HitboxSize = 5,
        ESP_Players = false,
        ESP_Mobs = false,
        ESP_Fruits = false,
        AutoHaki = false
    }
}

-- ==========================================
-- 3. UTILITY FUNCTIONS
-- ==========================================
local function Create(className, properties, parent)
    local inst = Instance.new(className)
    for k, v in pairs(properties) do inst[k] = v end
    if parent then inst.Parent = parent end
    return inst
end

local NotifGui = Create("ScreenGui", {Name="PBF_Notif", ResetOnSpawn=false, Parent=CoreGui})
local function Notify(title, text, type)
    local color = Config.Theme.Accent
    if type == "success" then color = Config.Theme.Success
    elseif type == "error" then color = Config.Theme.Danger end
    
    local frame = Create("Frame", {
        Size = UDim2.new(0, 280, 0, 50), Position = UDim2.new(1, 300, 0, 20),
        BackgroundColor3 = Config.Theme.Panel, BorderSizePixel = 0, Parent = NotifGui
    })
    Create("UICorner", {CornerRadius = UDim.new(0, 6)}, frame)
    Create("UIStroke", {Color = color, Thickness = 1}, frame)
    Create("Frame", {Size = UDim2.new(0, 4, 1, 0), BackgroundColor3 = color, Parent = frame})
    Create("TextLabel", {
        Size = UDim2.new(1, -20, 1, 0), Position = UDim2.new(0, 15, 0, 0),
        BackgroundTransparency = 1, Text = title .. "\n" .. text,
        TextColor3 = Config.Theme.Text, Font = Enum.Font.GothamBold, TextSize = 11,
        TextXAlignment = Enum.TextXAlignment.Left, Parent = frame
    })
    
    TweenService:Create(frame, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Position = UDim2.new(1, -300, 0, 20)}):Play()
    task.delay(3, function()
        TweenService:Create(frame, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {Position = UDim2.new(1, 300, 0, 20)}):Play()
        task.wait(0.3); frame:Destroy()
    end)
end

-- ==========================================
-- 4. UI SETUP & LOADING SCREEN
-- ==========================================
local ScreenGui = Create("ScreenGui", {Name="PBF_Premium_UI", ResetOnSpawn=false, Parent=CoreGui})

-- Loading Screen
local Loader = Create("Frame", {Size = UDim2.new(1,0,1,0), BackgroundColor3 = Config.Theme.Bg, Parent = ScreenGui})
local Title = Create("TextLabel", {
    Size = UDim2.new(1,0,0,50), Position = UDim2.new(0,0,0.4,0), BackgroundTransparency = 1,
    Text = "BLOX FRUITS PREMIUM VIP", TextColor3 = Config.Theme.Accent,
    Font = Enum.Font.GothamBlack, TextSize = 28, Parent = Loader
})
local BarBg = Create("Frame", {
    Size = UDim2.new(0, 300, 0, 6), Position = UDim2.new(0.5, -150, 0.5, 30),
    BackgroundColor3 = Config.Theme.Panel, BorderSizePixel = 0, Parent = Loader
})
local BarFill = Create("Frame", {Size = UDim2.new(0,0,1,0), BackgroundColor3 = Config.Theme.Accent, Parent = BarBg})

task.spawn(function()
    for i = 1, 20 do
        BarFill.Size = UDim2.new(i/20, 0, 1, 0)
        task.wait(0.05)
    end
    task.wait(0.3)
    TweenService:Create(Loader, TweenInfo.new(0.5), {BackgroundTransparency = 1}):Play()
    for _, v in pairs(Loader:GetDescendants()) do
        if v:IsA("TextLabel") or v:IsA("Frame") then
            TweenService:Create(v, TweenInfo.new(0.5), {BackgroundTransparency = 1, TextTransparency = 1}):Play()
        end
    end
    task.wait(0.5); Loader:Destroy()
    Notify("Hệ thống", "Tải thành công! Nhấn ⚙️ để mở.", "success")
end)

-- Main Frame
local Main = Create("Frame", {
    Size = UDim2.new(0, 550, 0, 350), Position = UDim2.new(0.5, -275, 0.5, -175),
    BackgroundColor3 = Config.Theme.Bg, BorderSizePixel = 0, Visible = false, Parent = ScreenGui
})
Create("UICorner", {CornerRadius = UDim.new(0, 8)}, Main)
Create("UIStroke", {Color = Config.Theme.Accent, Thickness = 1, Transparency = 0.5}, Main)

-- Top Bar
local TopBar = Create("Frame", {Size = UDim2.new(1,0,0,40), BackgroundColor3 = Config.Theme.Panel, Parent = Main})
Create("UICorner", {CornerRadius = UDim.new(0, 8)}, TopBar)
Create("TextLabel", {
    Size = UDim2.new(1,-100,1,0), Position = UDim2.new(0,15,0,0), BackgroundTransparency = 1,
    Text = "PREMIUM VIP", TextColor3 = Config.Theme.Accent, Font = Enum.Font.GothamBold,
    TextSize = 14, TextXAlignment = Enum.TextXAlignment.Left, Parent = TopBar
})

local CloseBtn = Create("TextButton", {
    Size = UDim2.new(0, 30, 0, 30), Position = UDim2.new(1, -40, 0.5, -15),
    BackgroundColor3 = Config.Theme.Danger, Text = "X", TextColor3 = Color3.new(1,1,1),
    Font = Enum.Font.GothamBold, Parent = TopBar
})
Create("UICorner", {CornerRadius = UDim.new(0, 4)}, CloseBtn)

-- Drag Logic (Mobile Touch Support)
local dragging, dragInput, dragStart, startPos
TopBar.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true; dragStart = input.Position; startPos = Main.Position
        input.Changed:Connect(function() if input.UserInputState == Enum.UserInputState.End then dragging = false end end)
    end
end)
TopBar.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then dragInput = input end
end)
UserInputService.InputChanged:Connect(function(input)
    if input == dragInput and dragging then
        local delta = input.Position - dragStart
        Main.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
    end
end)

-- Floating Button (Mobile Draggable)
local FAB = Create("TextButton", {
    Size = UDim2.new(0, 45, 0, 45), Position = UDim2.new(0, 20, 0.5, -22),
    BackgroundColor3 = Config.Theme.Panel, Text = "⚙️", TextSize = 22, TextColor3 = Config.Theme.Accent, Parent = ScreenGui
})
Create("UICorner", {CornerRadius = UDim.new(1, 0)}, FAB)
Create("UIStroke", {Color = Config.Theme.Accent, Thickness = 1.5}, FAB)

FAB.MouseButton1Click:Connect(function() Main.Visible = not Main.Visible end)
CloseBtn.MouseButton1Click:Connect(function() Main.Visible = false end)

-- ==========================================
-- 5. TABS & UI COMPONENTS
-- ==========================================
local TabBar = Create("Frame", {Size = UDim2.new(0, 120, 1, -40), Position = UDim2.new(0, 0, 0, 40), BackgroundColor3 = Config.Theme.Panel, Parent = Main})
local ContentArea = Create("Frame", {Size = UDim2.new(1, -120, 1, -40), Position = UDim2.new(0, 120, 0, 40), BackgroundColor3 = Config.Theme.Bg, Parent = Main})

local Tabs = {
    {Name = "HOME", Icon = "🏠"}, {Name = "AUTO FARM", Icon = "⚔️"},
    {Name = "COMBAT", Icon = "🥊"}, {Name = "FRUITS", Icon = "🍎"},
    {Name = "BOSSES", Icon = "👹"}, {Name = "TELEPORT", Icon = "🌍"},
    {Name = "ESP", Icon = "👁️"}, {Name = "PLAYER", Icon = "👤"},
    {Name = "SETTINGS", Icon = "⚙️"}
}

local TabContents = {}
for i, tab in ipairs(Tabs) do
    local btn = Create("TextButton", {
        Size = UDim2.new(1, 0, 0, 35), Position = UDim2.new(0, 0, 0, (i-1)*35),
        BackgroundTransparency = 1, Text = " " .. tab.Icon .. " " .. tab.Name,
        TextColor3 = Config.Theme.TextDim, Font = Enum.Font.GothamBold, TextSize = 11,
        TextXAlignment = Enum.TextXAlignment.Left, Parent = TabBar
    })
    
    local content = Create("ScrollingFrame", {
        Size = UDim2.new(1, -20, 1, -20), Position = UDim2.new(0, 10, 0, 10),
        BackgroundTransparency = 1, BorderSizePixel = 0, CanvasSize = UDim2.new(0,0,0,0),
        AutomaticCanvasSize = Enum.AutomaticSize.Y, ScrollBarThickness = 2, Visible = (i==1), Parent = ContentArea
    })
    Create("UIListLayout", {Padding = UDim.new(0, 8)}, content)
    TabContents[tab.Name] = content
    
    btn.MouseButton1Click:Connect(function()
        for name, c in pairs(TabContents) do c.Visible = (name == tab.Name) end
        for _, b in ipairs(TabBar:GetChildren()) do if b:IsA("TextButton") then b.TextColor3 = Config.Theme.TextDim end end
        btn.TextColor3 = Config.Theme.Accent
    end)
end
TabBar:GetChildren()[1].TextColor3 = Config.Theme.Accent

local function CreateToggle(parent, text, default, callback)
    local frame = Create("Frame", {Size = UDim2.new(1, 0, 0, 35), BackgroundColor3 = Config.Theme.Panel, Parent = parent})
    Create("UICorner", {CornerRadius = UDim.new(0, 6)}, frame)
    Create("TextLabel", {Size = UDim2.new(1, -60, 1, 0), Position = UDim2.new(0, 10, 0, 0), BackgroundTransparency = 1, Text = text, TextColor3 = Config.Theme.Text, Font = Enum.Font.Gotham, TextSize = 12, TextXAlignment = Enum.TextXAlignment.Left, Parent = frame})
    local btn = Create("TextButton", {Size = UDim2.new(0, 40, 0, 20), Position = UDim2.new(1, -50, 0.5, -10), BackgroundColor3 = default and Config.Theme.Accent or Color3.fromRGB(50,50,60), Text = default and "ON" or "OFF", TextColor3 = Color3.new(1,1,1), Font = Enum.Font.GothamBold, TextSize = 10, Parent = frame})
    Create("UICorner", {CornerRadius = UDim.new(0, 4)}, btn)
    local state = default
    btn.MouseButton1Click:Connect(function()
        state = not state; btn.Text = state and "ON" or "OFF"
        btn.BackgroundColor3 = state and Config.Theme.Accent or Color3.fromRGB(50,50,60)
        pcall(callback, state)
    end)
end

local function CreateSlider(parent, text, min, max, default, callback)
    local frame = Create("Frame", {Size = UDim2.new(1, 0, 0, 45), BackgroundColor3 = Config.Theme.Panel, Parent = parent})
    Create("UICorner", {CornerRadius = UDim.new(0, 6)}, frame)
    local lbl = Create("TextLabel", {Size = UDim2.new(1, -20, 0, 20), Position = UDim2.new(0, 10, 0, 5), BackgroundTransparency = 1, Text = text..": "..default, TextColor3 = Config.Theme.Text, Font = Enum.Font.Gotham, TextSize = 12, TextXAlignment = Enum.TextXAlignment.Left, Parent = frame})
    local bar = Create("Frame", {Size = UDim2.new(1, -20, 0, 6), Position = UDim2.new(0, 10, 0, 28), BackgroundColor3 = Color3.fromRGB(50,50,60), Parent = frame})
    Create("UICorner", {CornerRadius = UDim.new(1,0)}, bar)
    local fill = Create("Frame", {Size = UDim2.new((default-min)/(max-min), 0, 1, 0), BackgroundColor3 = Config.Theme.Accent, Parent = bar})
    Create("UICorner", {CornerRadius = UDim.new(1,0)}, fill)
    local drag = false
    bar.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
            drag = true
            local x = math.clamp((i.Position.X - bar.AbsolutePosition.X) / bar.AbsoluteSize.X, 0, 1)
            local val = math.floor(min + ((max - min) * x))
            fill.Size = UDim2.new(x, 0, 1, 0); lbl.Text = text..": "..val
            pcall(callback, val)
        end
    end)
    UserInputService.InputEnded:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then drag = false end end)
    UserInputService.InputChanged:Connect(function(i)
        if drag and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
            local x = math.clamp((i.Position.X - bar.AbsolutePosition.X) / bar.AbsoluteSize.X, 0, 1)
            local val = math.floor(min + ((max - min) * x))
            fill.Size = UDim2.new(x, 0, 1, 0); lbl.Text = text..": "..val
            pcall(callback, val)
        end
    end)
end

local function CreateButton(parent, text, callback)
    local btn = Create("TextButton", {Size = UDim2.new(1, 0, 0, 32), BackgroundColor3 = Config.Theme.Panel, Text = text, TextColor3 = Config.Theme.Text, Font = Enum.Font.GothamBold, TextSize = 12, Parent = parent})
    Create("UICorner", {CornerRadius = UDim.new(0, 6)}, btn)
    btn.MouseButton1Click:Connect(function() pcall(callback) end)
end

