-- TAB SETTINGS
local SetTab = TabContents["SETTINGS"]
CreateButton(SetTab, "Lưu Cài Đặt", function() Notify("Hệ thống", "Đã lưu (Demo)", "success") end)
CreateButton(SetTab, "STOP ALL (Khẩn Cấp)", function()
    for k, v in pairs(Config.State) do if type(v) == "boolean" then Config.State[k] = false end end
